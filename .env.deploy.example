# Production deploy (SSH + rsync) — AureusERP
#   cp .env.deploy.example .env.deploy
#
# AureusERP requires PHP 8.3+ (Laravel 13).
#
# Deploy:
#   bash scripts/deploy-prod.sh              # git-changed files only (default)
#   bash scripts/deploy-prod.sh all --yes    # full tree (safe excludes)
#
# Hostinger (default php is 8.2, hPanel locked):
#   DEPLOY_HOSTINGER=1
#   → auto-detects php83 CLI, syncs vendor/ from your Mac, patches .htaccess for web PHP 8.3

DEPLOY_HOST=user@your-server.com
DEPLOY_PORT=22

# Server path to the Laravel app root (where artisan lives)
LARAVEL_PATH=/home/USER/domains/example.com/public_html

# Hostinger shared hosting — enable on-the-fly PHP 8.3 workaround
# DEPLOY_HOSTINGER=1
# DEPLOY_SYNC_VENDOR=1
# DEPLOY_WEB_PHP_HANDLER=php84

# PHP CLI on the server — script auto-probes if this binary is missing or too old
# DEPLOY_PHP_BIN=php83
# Or full path: DEPLOY_PHP_BIN=/opt/alt/php83/usr/bin/php

# Optional: override composer command (default: $DEPLOY_PHP_BIN composer)
# DEPLOY_COMPOSER_BIN="php83 /usr/local/bin/composer"

# Optional SSH private key (default: ssh-agent)
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# Optional maintenance mode secret (php artisan down --secret=...)
# DEPLOY_DOWN_SECRET=your-secret-token

# Composer flags on the server (when not using DEPLOY_SYNC_VENDOR)
COMPOSER_INSTALL_FLAGS="--no-dev --optimize-autoloader --no-interaction"

# ---------------------------------------------------------------------------
# Production .env safety (set on the server — not uploaded by deploy)
# ---------------------------------------------------------------------------
# ALLOW_DESTRUCTIVE_ARTISAN_COMMANDS=false
# Blocks migrate:fresh, db:seed, plugin uninstall, erp:install --force on live DB.
# For disaster recovery only: set true temporarily (see auth.md), then false again.
#
# Cron (required for scheduled notifications / SLA / inventory replenishment):
#   * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
#
# Never run on production:
#   php artisan migrate:fresh
#   php artisan db:seed
#   php artisan erp:install --force
#   php artisan {plugin}:uninstall --force
#
# Deploy removes test artifacts after each run: tests/, plugin tests/, phpunit.xml,
# .env.testing.example, database/factories/
