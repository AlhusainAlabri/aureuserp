APP_NAME=YourERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Muscat
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=OMR

# Dompdf Arabic export font (Amiri | DejaVu Sans). Amiri is bundled under resources/fonts/amiri.
PDF_ARABIC_FONT=Amiri

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
# Use file (or redis) — never database in production; database cache adds ~15 SQL queries per request.
CACHE_PREFIX=

DEBUGBAR_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notification operations (production monitoring)
# NOTIFICATION_OPS_EMAIL=ops@example.com
# NOTIFICATION_REPORT_HOURS=24
# NOTIFICATION_OPS_FAILED_JOBS_THRESHOLD=5
# NOTIFICATION_OPS_FAILED_EMAIL_RATE=0.05
# NOTIFICATION_OPS_QUEUE_BACKLOG=250

# MSG91 SMS (optional — payment notifications when sales plugin is installed)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=AUREUS
# MSG91_ROUTE=4
# MSG91_ADMIN_MOBILE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Slow query recorder — enable while manually testing pages, then run: php artisan performance:report
SLOW_QUERY_LOG_ENABLED=false
SLOW_QUERY_THRESHOLD_MS=100
SLOW_QUERY_LOG_ALL_REQUESTS=true
SLOW_QUERY_HEAVY_QUERY_COUNT=75
SLOW_QUERY_RETENTION_DAYS=14

# Block migrate:fresh, db:seed, plugin uninstall, etc. on live databases.
# Set true only for intentional recovery (see auth.md). Never enable on production.
ALLOW_DESTRUCTIVE_ARTISAN_COMMANDS=false

# Hide /admin/plugins from the menu, dashboard, and every user.
# Open it while logged in: /admin/plugins?access=YOUR_SECRET
HIDE_PLUGINS_UI=true
PLUGINS_UI_SECRET=

# Optional token for /health endpoint (send as X-Health-Token header when set)
# HEALTH_CHECK_TOKEN=

# GitHub pull deploy — enable only on the server, never on a developer checkout.
# Setup: System → Updates. Leave disabled until the deploy key and branch are ready.
# GITHUB_DEPLOY_ENABLED=false
# GITHUB_DEPLOY_REMOTE=origin
# GITHUB_DEPLOY_BRANCH=master
# GITHUB_DEPLOY_BACKUP=true
# GITHUB_DEPLOY_SHIELD=true
# GITHUB_DEPLOY_PHP=/usr/bin/php
# GITHUB_DEPLOY_COMPOSER=composer
# GITHUB_DEPLOY_MAINTENANCE_SECRET=choose-a-long-secret
# GITHUB_DEPLOY_FILAMENT_CACHE=false

# Branding — bundled logos (paths relative to public/) shown until a logo is uploaded
# under Settings > Branding. The Nodhum logos are the default; point them at a customer's
# own files if needed, for example:
# BRANDING_DEFAULT_LOGO=images/customer/logo.png
# BRANDING_DEFAULT_LOGO_COMPACT=images/customer/mark.png
# BRANDING_DEFAULT_LOGO_DARK=images/customer/logo-dark.png
# BRANDING_DEFAULT_LOGO_COMPACT_DARK=images/customer/mark-dark.png

# Company name used by the first install (can also be passed as --company-name).
# ERP_COMPANY_NAME=

# Sample employees and inventory for demos only. Never enable on a customer install.
# ERP_SEED_DEMO_DATA=false
