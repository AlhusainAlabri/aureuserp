APP_NAME=AureusERP
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Copy APP_KEY from your local .env file.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nodhum_erp_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

SETTINGS_CACHE_ENABLED=true
SETTINGS_CACHE_MEMO=true

# Slow query recorder — enable while manually testing pages, then run: php artisan performance:report
SLOW_QUERY_LOG_ENABLED=false
SLOW_QUERY_THRESHOLD_MS=100
SLOW_QUERY_LOG_ALL_REQUESTS=true
SLOW_QUERY_HEAVY_QUERY_COUNT=75
SLOW_QUERY_RETENTION_DAYS=14
