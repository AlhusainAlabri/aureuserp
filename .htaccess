<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Uploaded files: /storage/... is served from public/storage (a link to storage/app/public).
    # Only that folder is reachable this way; the app's own storage/ directory stays blocked below.
    RewriteRule ^storage/(.+)$ public/storage/$1 [L,NC]

    # Block web access to Laravel internals (repo root = public_html on Hostinger)
    RewriteRule ^(app|bootstrap|config|database|plugins|resources|routes|storage|tests|vendor|node_modules|\.github)(/|$) - [F,L,NC]
    RewriteRule ^(\.env|\.env\.|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.git|\.gitignore|README\.md|auth\.md)(/.*)?$ - [F,L,NC]
    RewriteRule ^(public/)?adminer\.php$ - [F,L,NC]

    # Route all requests into Laravel's public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<Files ".env">
    Require all denied
</Files>

<FilesMatch "^\.env\.">
    Require all denied
</FilesMatch>

<Files "adminer.php">
    Require all denied
</Files>

<Files "auth.md">
    Require all denied
</Files>
